# Numeric host IDs the containers run as. MUSICBOT_UID owns the bot state;
# MUSICBOT_GID must be the group that OWNS THE MUSIC LIBRARY, not the user's
# private group — everything written to the library is created with it, and
# the wrong value leaves tracks no other writer can retag.
MUSICBOT_UID=1000
MUSICBOT_GID=1000

# Telegram bot token from @BotFather
TG_TOKEN=

# Navidrome credentials (Subsonic API)
NAVIDROME_URL=http://localhost:4533
NAVIDROME_USER=
NAVIDROME_PASS=

# Comma-separated Telegram user IDs allowed to use the bot
ALLOWED_USERS=

# Host path holding your music library.
MUSIC_LIBRARY_DIR=/media/music

# Local imports, tagging and browsing work without a download provider.
DOWNLOAD_PROVIDER=none
# Optional Soulseek setup: docs/providers/soulseek.md and .env.soulseek.example.

# MP3 bitrate Navidrome transcodes to for inline playback (default: 320)
#STREAM_BITRATE=320

# --- Optional ---

# Container image + tag for the music-bot service (read by compose.yaml).
# Defaults to the public image; override if you pull from your own registry.
#MUSICBOT_IMAGE=ghcr.io/eeegoloauq/music-bot
#MUSICBOT_TAG=latest

# Public Navidrome URL for share links (disabled if not set)
#NAVIDROME_PUBLIC_URL=https://music.example.com

# Import cap per audio file (default 2 GiB; 0 disables the size cap).
#MAX_FILE_BYTES=2147483648

# Local-upload intake: drop a .zip / folder of tracks into ./bot-data/uploads
# on the host (no setting needed) and the bot identifies, tags and files it.
# UPLOAD_MAX_TOTAL_BYTES caps one drop after extraction (default 10 GiB);
# per-file cap reuses MAX_FILE_BYTES.
#UPLOAD_MAX_TOTAL_BYTES=10737418240

# One-page upload site feeding the same folder (unset = off). Also uncomment
# the ports: block on music-bot in compose.yaml. No auth — LAN only.
#UPLOAD_HTTP_PORT=8080

# Last.fm API key. Optional — when set, community tags ("witch house",
# "chillwave", etc.) get merged into Deezer's coarser album genres. Free
# registration at https://www.last.fm/api/account/create.
#LASTFM_API_KEY=

# Outbound proxy. All HTTP sessions are configured with trust_env=True so
# they pick up HTTP_PROXY / HTTPS_PROXY / NO_PROXY. If a specific upstream
# throttles your proxy IP (Deezer, lrclib are common offenders),
# add its host to NO_PROXY so that one endpoint goes direct.
#HTTP_PROXY=http://your-proxy:1080
#HTTPS_PROXY=http://your-proxy:1080
#NO_PROXY=localhost,127.0.0.1,host.docker.internal,slskd
