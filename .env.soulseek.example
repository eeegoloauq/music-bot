# Append the settings you need to your private .env. Do not replace the base settings.
# See docs/providers/soulseek.md.
DOWNLOAD_PROVIDER=soulseek

# For a local daemon started with compose.soulseek.yaml:
SOULSEEK_USERNAME=
SOULSEEK_PASSWORD=
SLSKD_LISTEN_PORT=50300

# For an existing daemon, use the provider image and set its API address/key.
#SLSKD_HOST=http://slskd:5030
#SLSKD_API_KEY=
# Path to completed downloads as seen from inside the bot container.
#SLSKD_DOWNLOAD_DIR=/music/.slskd-downloads

# Library share rescans are separate from downloads and disabled by default.
# Only enable after configuring the folders you intend to share in slskd.
SOULSEEK_SHARE_SCAN_ENABLED=false

# Peer selection and transfer settings (defaults shown).
#MAX_BIT_DEPTH=24
#MAX_SAMPLE_RATE_HZ=96000
#SLSKD_MAX_PEER_ATTEMPTS=3
#SLSKD_SEARCH_MIN_INTERVAL_SECS=10
#SLSKD_STALL_SECS=120
