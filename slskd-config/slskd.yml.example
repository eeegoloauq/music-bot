# Optional slskd configuration; copy to slskd-config/slskd.yml if needed.
# Login and staging paths come from compose.soulseek.yaml.
# Sharing is disabled here. To share a chosen directory, mount it into slskd
# read-only and add its container path below. See docs/providers/soulseek.md.

remote_configuration: false

soulseek:
  description: "music collector"

shares:
  directories: []

web:
  authentication:
    disabled: true
  port: 5030
  https:
    disabled: true

filters:
  search:
    # Drop 1-2 character search requests: they match almost the whole share and
    # cost real CPU to answer, and nobody searching that way wants our library.
    request:
      - ^.{1,2}$
